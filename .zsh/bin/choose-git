#!/bin/bash

preview_with_glow() {
  # https://github.com/charmbracelet/glow/issues/654
  echo "CLICOLOR_FORCE=1 COLORTERM=truecolor glow -p -s dark $(ghq root)/{}/README.md"
}

slugify() {
  echo $(sed "s/\./_/g" <<< $1)
}

main() {
  active_project=$(
    ghq list \
    | fzf \
      --style full \
      --list-label "Repositories" \
      --preview-label "README.md" \
      --input-label "Keyword" \
      --preview "$(preview_with_glow)"
  )

  if [[ -z "$active_project" ]]; then
    exit 1
  fi

  session=$(slugify "$active_project")
  session_exists=$(tmux list-sessions -F "#S" | grep -x "$session")

  if ! session_exists; then
    tmux new-session -d -s "$session" -c "$(ghq root)/${active_project}"
  fi

  tmux switch-client -t "$session"
}

main
