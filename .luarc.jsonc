// これがないとグローバル変数 `vim` がないって怒られる
// https://luals.github.io/wiki/configuration/
// https://lsp-zero.netlify.app/docs/guide/neovim-lua-ls.html
{
  "runtime.version": "LuaJIT",
  "runtime.path": [
    "lua/?.lua",
    "lua/?/init.lua"
  ],
  "diagnostics.globals": ["vim"],
  "workspace.checkThirdParty": false,
  "workspace.library": [
    "$VIMRUNTIME"
  ]
}
